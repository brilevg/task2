{
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "ID",
      "vendor_release_date",
      "vendor_release_url",
      "url",
      "published_date",
      "updated_date",
      "description",
      "cvss_list",
      "cpe_list",
      "cwe"
    ],
    "properties": {
      "ID": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,7}$"
      },
      "vendor_release_date": {
        "type": ["string", "null"],
        "format": "date"
      },
      "vendor_release_url": {
        "type": "string",
        "format": "uri"
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "published_date": {
        "type": ["string", "null"]
      },
      "updated_date": {
        "type": ["string", "null"]
      },
      "description": {
        "type": ["string", "null"],
        "minLength": 1
      },

      "cvss_list": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["version", "score", "vector", "severity"],
          "properties": {
            "version": { "type": "string" },
            "score": { "type": ["number", "null"] },
            "vector": { "type": ["string", "null"] },
            "severity": { "type": ["string", "null"] }
          }
        }
      },

      "cpe_list": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },

      "cwe": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "description": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}